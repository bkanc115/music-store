# Пример настроек. Скопируйте в .env (make setup делает это сам) и задайте свои значения.
# Файл .env в репозиторий НЕ коммитится.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL для локальной разработки (поднимается командой make up)
POSTGRES_DB=musicstore
POSTGRES_USER=musicstore
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://musicstore:change-me@localhost:5432/musicstore

# Ключ подписи сессий: длинная случайная строка, например
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Администратор, создаваемый командой make seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
