# Параметры стенда (не секретные). Секреты — в secrets.env (не хранится в репозитории).

# Сеть VMware NAT (VMnet8): 192.168.42.0/24, шлюз и DNS — 192.168.42.2
APP_HOSTNAME=ms-app
APP_IP=192.168.42.10
DB_HOSTNAME=ms-db
DB_IP=192.168.42.20
NET_PREFIX=24
GATEWAY=192.168.42.2
DNS=192.168.42.2

# Пользователи ОС
ADMIN_USER=sysadmin        # администрирование: вход по SSH-ключу, sudo
APP_USER=musicstore        # запуск приложения: системный, без shell и без входа

# База данных
DB_NAME=musicstore
DB_MIGRATOR_ROLE=musicstore_migrator   # владелец схемы, только для миграций
DB_APP_ROLE=musicstore_app             # приложение: только SELECT/INSERT/UPDATE/DELETE

# Приложение
APP_PORT=8000
REPO_URL=https://github.com/bkanc115/music-store.git
APP_VERSION=v0.2.0
APP_ROOT=/opt/musicstore
APP_CONFIG_DIR=/etc/musicstore
APP_LOG_DIR=/var/log/musicstore
